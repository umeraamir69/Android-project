<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Cloud STT + Gemini calls (arch doc §1.2) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lecture capture (Track 3) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name=".LectureLensApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LectureLens">
        <!-- Single-activity nav host; screens are fragments in nav_graph.xml -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Track 3: foreground recording service keeps the mic alive off-screen -->
        <service
            android:name=".data.audio.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- Design-review tool; reachable from the Settings placeholder -->
        <activity
            android:name=".ThemeShowcaseActivity"
            android:exported="false"
            android:label="@string/showcase_title"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.section.LibraryActivity"
            android:exported="false"
            android:label="@string/title_library"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.section.SearchActivity"
            android:exported="false"
            android:label="@string/title_search"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.section.UploadActivity"
            android:exported="false"
            android:label="@string/title_upload"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.section.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.section.LectureActivity"
            android:exported="false"
            android:label="@string/title_lecture"
            android:parentActivityName=".MainActivity" />
        <!-- Track 5: share exported Markdown notes -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>