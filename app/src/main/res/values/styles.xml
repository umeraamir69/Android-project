<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Soft corner language — modern M3, not overly pill-shaped -->
    <style name="ShapeAppearance.LectureLens.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.LectureLens.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.LectureLens.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.LectureLens.Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">1dp</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.LectureLens.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.LectureLens.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">?attr/textAppearanceTitleLarge</item>
        <item name="subtitleTextAppearance">?attr/textAppearanceBodyMedium</item>
    </style>

    <style name="Widget.LectureLens.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:minHeight">64dp</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.LectureLens.BottomNav.ActiveIndicator</item>
        <item name="itemTextAppearanceActive">?attr/textAppearanceLabelMedium</item>
        <item name="itemTextAppearanceInactive">?attr/textAppearanceLabelMedium</item>
        <item name="itemRippleColor">?attr/colorPrimary</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
    </style>

    <style name="Widget.LectureLens.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:height">32dp</item>
        <item name="android:width">56dp</item>
        <item name="marginHorizontal">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LectureLens.SmallComponent</item>
        <item name="android:color">?attr/colorSecondaryContainer</item>
    </style>
</resources>
