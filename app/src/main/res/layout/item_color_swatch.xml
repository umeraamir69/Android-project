<?xml version="1.0" encoding="utf-8"?>
<!--
    One color swatch tile. The hosting activity sets the background tint on
    @id/swatch_card and the role name on @id/swatch_label per swatch, so the
    same layout can render every M3 color role.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swatch_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <TextView
        android:id="@+id/swatch_label"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="8dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textAlignment="center" />
</com.google.android.material.card.MaterialCardView>
